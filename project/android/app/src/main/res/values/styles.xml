<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">#0C1424</item>
        <item name="android:navigationBarColor">#0C1424</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0C1424</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">#0C1424</item>
        <item name="android:navigationBarColor">#0C1424</item>
    </style>

    <style name="WidgetSettingsTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">#F2F3F5</item>
        <item name="android:statusBarColor">#F2F3F5</item>
        <item name="android:navigationBarColor">#F2F3F5</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>